[Unit]
Description=PCG File Sync Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/pcg-sync start
Restart=on-failure
RestartSec=30
StandardOutput=append:%h/.pcg/sync.log
StandardError=append:%h/.pcg/sync.log

[Install]
WantedBy=default.target
