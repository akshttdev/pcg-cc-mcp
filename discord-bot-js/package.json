{
  "name": "pcg-discord-bot",
  "version": "1.0.0",
  "description": "PCG Discord voice bot — Nora and Topsi with DAVE E2EE support",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file=../.env src/index.js",
    "start:nora": "AGENT=Nora node --env-file=../.env src/index.js",
    "start:topsi": "AGENT=Topsi node --env-file=../.env src/index.js",
    "dev": "VOICE_DEBUG=1 node --env-file=../.env src/index.js"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^1.0.0-dev.1772884937-84b85f4c9",
    "@snazzah/davey": "^0.1.9",
    "better-sqlite3": "^11.9.1",
    "discord.js": "^14.25.1",
    "ffmpeg-static": "^5.2.0",
    "prism-media": "^1.3.5",
    "sodium-native": "^5.0.0",
    "uuid": "^11.0.5"
  }
}
