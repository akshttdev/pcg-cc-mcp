#!/bin/bash
# Pre-commit hook: Migration Timestamp Collision Detection
#
# Prevents commits with duplicate migration timestamps.
# Install: git config core.hooksPath .githooks
#
# What it checks:
# 1. Duplicate timestamps in staged migration files
# 2. Same-day collisions with existing migrations (warning only)

# Exit on any unhandled error
set -e

# Check for migration files in staged changes
MIGRATIONS=$(git diff --cached --name-only | grep 'crates/db/migrations/.*\.sql$' || true)

if [ -z "$MIGRATIONS" ]; then
    # No migrations staged, nothing to check
    exit 0
fi

echo "Checking migrations for timestamp collisions..."

# Extract timestamps from staged migration files
NEW_TIMESTAMPS=$(echo "$MIGRATIONS" | sed 's/.*\/\([0-9]*\)_.*/\1/' | sort)

# Check for duplicate timestamps in staged files
DUPLICATES=$(echo "$NEW_TIMESTAMPS" | uniq -d)
if [ -n "$DUPLICATES" ]; then
    echo ""
    echo "ERROR: Duplicate migration timestamps detected in staged files:"
    echo ""
    for TS in $DUPLICATES; do
        echo "  Timestamp: $TS"
        echo "$MIGRATIONS" | grep "$TS" | sed 's/^/    /'
    done
    echo ""
    echo "Fix: Rename one migration to use a different timestamp."
    echo "     Use ./scripts/new-migration.sh to generate unique timestamps."
    exit 1
fi

# Check for same-day collisions with existing migrations (warning only)
HAS_WARNING=0
for TS in $NEW_TIMESTAMPS; do
    DAY="${TS:0:8}"
    # Count existing migrations for this day (excluding the new one)
    EXISTING=$(ls crates/db/migrations/${DAY}*.sql 2>/dev/null | wc -l | tr -d ' ')

    # If there are multiple migrations for this day, warn
    if [ "$EXISTING" -gt 1 ]; then
        if [ "$HAS_WARNING" -eq 0 ]; then
            echo ""
            echo "WARNING: Multiple migrations detected for the same day:"
            HAS_WARNING=1
        fi
        echo "  Date: ${DAY:0:4}-${DAY:4:2}-${DAY:6:2} ($EXISTING migrations)"
        ls crates/db/migrations/${DAY}*.sql 2>/dev/null | sed 's/.*\//    /'
    fi
done

if [ "$HAS_WARNING" -eq 1 ]; then
    echo ""
    echo "This is OK if timestamps differ (YYYYMMDDHHMMSS), but verify no conflicts."
    echo ""
fi

echo "Migration timestamps OK"
